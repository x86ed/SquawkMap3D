# MapTiler API key — used for the light/dark base map style and terrain-DEM source.
# Get one free at https://cloud.maptiler.com/account/keys/
NEXT_PUBLIC_MAPTILER_KEY=

# OpenAIP API key — used for the OpenAIP airspace overlay layer. Optional:
# when unset, the OpenAIP layer toggle is a no-op instead of erroring.
# Get one free at https://www.openaip.net/
NEXT_PUBLIC_OPENAIP_API_KEY=

# Base URL of your ADS-B feeder's aircraft.json endpoint (readsb/dump1090-fa,
# tar1090-compatible), e.g. http://192.168.1.50:8080/data/aircraft.json.
# Optional: when unset, the aircraft tracks layer stays off instead of
# erroring. The feeder must allow cross-origin requests from this app's
# origin (Access-Control-Allow-Origin) for the browser to fetch it directly.
NEXT_PUBLIC_FEEDER_URL=
