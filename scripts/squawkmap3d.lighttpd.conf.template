# lighttpd site config for SquawkMap3D's static export, served on its own
# port alongside tar1090 on the same lighttpd instance. Structure mirrors
# tar1090's own install.sh-generated 95-tar1090-otherport.conf (a
# $SERVER["socket"] block binding a dedicated port), fetched and confirmed
# against tar1090's actual repo during drafting — see
# openspec/changes/deploy-to-feeder/design.md Decision 4. Never edits
# tar1090's own conf; installed as a separate conf-available/conf-enabled
# file. Rendered by scripts/deploy-to-feeder.sh, which substitutes the
# __REMOTE_DIR__/__PORT__ tokens below.

$SERVER["socket"] == ":__PORT__" {
    server.document-root = "__REMOTE_DIR__"
    index-file.names     = ( "index.html" )

    $HTTP["url"] =~ "^/data/aircraft\.json$" {
        setenv.add-response-header = ( "Cache-Control" => "no-cache" )
    }
}
